[SpamFilter]
[KillThreadsFilter]

[FolderNameFilter]
folder_lowercases = true
maildir_separator = /

[HeaderMatchingFilter.1]
header = List-Id
pattern = <linux-kselftest\.vger\.kernel\.org>
tags = +lists;+linux-kselftest;

[HeaderMatchingFilter.2]
header = List-Id
pattern = <linux-riscv\.lists\.infradead\.org>
tags = +lists;+linux-riscv;

[HeaderMatchingFilter.3]
header = List-Id
pattern = <rust-for-linux\.vger\.kernel\.org>
tags = +lists;+rust-for-linux;

[HeaderMatchingFilter.4]
header = List-Id
pattern = <asahi\.lists\.linux\.dev>
tags = +lists;+asahi;

[HeaderMatchingFilter.5]
header = List-Id
pattern = <spacemit\.lists\.linux\.dev>
tags = +lists;+spacemit;

[HeaderMatchingFilter.50]
header = To
pattern = kernel-team@lists\.ubuntu\.com
tags = +ktml;

[HeaderMatchingFilter.51]
header = To
pattern = canonical-kernel-esm@lists\.canonical\.com
tags = +ktml-esm;

[HeaderMatchingFilter.52]
header = To
pattern = canonical-kernel-team@lists\.canonical\.com
tags = +kernel-team;

[HeaderMatchingFilter.53]
header = From
pattern = forgejo-bot@canonical\.com
tags = +forgejo;

[HeaderMatchingFilter.53]
header = From
pattern = jira@warthogs.atlassian.net
tags = +jira;

[LaunchpadFilter]

[InboxFilter]

[MailMover]
folders = canonical/Inbox
rename = True
max_age = 30

# rules
canonical/Inbox = 'tag:launchpad-spam':canonical/lp-spam
