# vim:ft=msmtp
# All Accounts

defaults
auth on
tls on
# tls_starttls off
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/.msmtp.log

# Use the config below if you opted-in for gmail

account canonical
protocol smtp
host smtp.gmail.com
port 587
from vinicius.peixoto@canonical.com
maildomain canonical.com
domain canonical.com
user vinicius.peixoto@canonical.com
passwordeval "secret-tool lookup mail canonical"

# Use the config below if you opted-out of gmail and use the company mail
# server instead

