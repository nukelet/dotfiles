# vim:ft=msmtp
# All Accounts

defaults
auth on
tls on
tls_starttls off
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/.msmtp.log

account canonical
protocol smtp
host smtp.gmail.com
port 587
from vinicius.peixoto@canonical.com
maildomain canonical.com
domain canonical.com
user vinicius.peixoto@canonical.com
passwordeval "secret-tool lookup mail canonical"

account lkcamp
protocol smtp
host smtp.purelymail.com
port 465
from vpeixoto@lkcamp.dev
maildomain lkcamp.dev
user vpeixoto@lkcamp.dev
passwordeval "secret-tool lookup mail lkcamp"

# Set default account to canonical (optional)
account default : canonical
